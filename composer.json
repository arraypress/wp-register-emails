{
  "name": "arraypress/wp-register-emails",
  "description": "Merge tags, HTML email components and named transactional emails for WordPress plugins.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpunit/phpunit": "^12.0",
    "squizlabs/php_codesniffer": "^3.13.5",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "suggest": {
    "arraypress/wp-currencies": "Formats an amount in the currency an order was placed in.",
    "arraypress/wp-field-kit": "Its email_editor field draws the merge-tag chooser; email_tags_for_editor() feeds it."
  },
  "autoload": {
    "psr-4": {
      "ArrayPress\\RegisterEmails\\": "src/"
    },
    "files": [
      "src/Utils/Functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "ArrayPress\\RegisterEmails\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "phpcs",
    "format": "phpcbf --standard=phpcs-format.xml.dist",
    "format:check": "phpcs --standard=phpcs-format.xml.dist"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist",
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/arraypress/wp-register-emails/issues",
    "source": "https://github.com/arraypress/wp-register-emails"
  },
  "keywords": [
    "wordpress",
    "email",
    "merge-tags",
    "html-email",
    "transactional-email",
    "email-templates",
    "wp-mail"
  ]
}
